PORT=3000

# Database Configuration (Option 1: URL / Connection String for TiDB/Aiven/Railway)
# DATABASE_URL=mysql://user:password@host:4000/grozzby?ssl={"rejectUnauthorized":true}

# Database Configuration (Option 2: Individual variables)
DB_HOST=localhost
DB_PORT=3306
DB_USER=grozzby
DB_PASSWORD=grozzbypass
DB_NAME=grozzby
DB_SSL=false

# JWT Authentication Secrets (Use 32+ char random strings in production)
JWT_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!

# SMTP Configuration (Optional - in dev, OTP codes are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@grozzby.com
